# dotenv package .env files k varibales ko code me access karwa ne k liye use hota h 
#// dotenv package is used to load environment variables from .env file into Node.js code
MONGO_URI=mongodb://127.0.0.1:27017/apartmentCommunity
#MongoDB protocol:-mongodb:// , 27017:-mongo_port , apartmentCommunity:-db name , 127.0.0.1 = mera apna computer
JWT_SECRET=mysecretkey123
